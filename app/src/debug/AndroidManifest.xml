<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Debug builds only. Opened from Home → Developer → Sensor recorder; it no longer has its
      own launcher icon, so the phone shows one MapLens icon.
    -->
    <activity android:name=".debug.RecorderActivity"
      android:label="@string/recorder_launcher_label"
      android:exported="false"
      android:screenOrientation="fullSensor"
      android:configChanges="orientation|screenSize"
      android:theme="@style/RecorderTheme" />
    <activity android:name=".debug.OrientScanActivity"
      android:exported="false"
      android:screenOrientation="portrait"
      android:windowSoftInputMode="stateAlwaysHidden"
      android:theme="@style/RecorderTheme" />
    <!-- Debug only: runs the sign-scan pipeline on drawn plaques (#19); started over adb. -->
    <activity android:name=".debug.SignSelfTestActivity"
      android:exported="true"
      android:theme="@style/MapLens.Theme" />
    <activity android:name=".debug.EditFixtureActivity"
      android:exported="false"
      android:theme="@style/MapLens.Theme" />
  </application>
</manifest>
