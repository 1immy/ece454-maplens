<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-feature android:name="android.hardware.camera" android:required="true" />
  <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />
  <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true" />

  <uses-permission android:name="android.permission.CAMERA" />
  <!-- Local link to the temi guide robot (same hotspot or Wi-Fi); no internet is used. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="android.permission.VIBRATE" />

  <application
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:label="@string/app_name"
    android:theme="@style/MapLens.Theme">
    <activity
      android:name=".TemiDevActivity"
      android:exported="false"
      android:screenOrientation="portrait" />
    <activity
      android:name=".PosterCaptureActivity"
      android:exported="false"
      android:screenOrientation="portrait" />
    <activity
      android:name=".GraphEditorActivity"
      android:exported="false"
      android:screenOrientation="portrait"
      android:windowSoftInputMode="adjustResize" />
    <!-- Navigation on a saved map, or on the bundled EH3 map from Developer. -->
    <activity
      android:name=".IndoorNavActivity"
      android:exported="false"
      android:label="@string/home_dev_nav"
      android:screenOrientation="portrait"
      android:windowSoftInputMode="adjustNothing" />
    <activity
      android:name=".HomeActivity"
      android:exported="true"
      android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
