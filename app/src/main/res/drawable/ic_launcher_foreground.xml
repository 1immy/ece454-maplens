  <path android:pathData="M21,57a33,33 0,1 0,66,0a33,33 0,1 0,-66,0z">
    <aapt:attr name="android:fillColor">
      <gradient
        android:type="radial"
        android:centerX="54" android:centerY="57"
        android:gradientRadius="33">
          <item android:offset="0.82" android:color="#590A1D4A" />
          <item android:offset="1" android:color="#000A1D4A" />
      </gradient>
    </aapt:attr>
  </path>
  <!-- Rim. -->
  <path android:pathData="M24,54a30,30 0,1 0,60,0a30,30 0,1 0,-60,0z">
