  android:viewportHeight="108">
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient
        android:type="linear"
        android:startX="0" android:startY="0"
        android:endX="108" android:endY="108">
          <item android:offset="0" android:color="#FF3B8BFA" />
          <item android:offset="1" android:color="#FF1550B5" />
      </gradient>
    </aapt:attr>
  </path>
  <path
    android:strokeColor="#21FFFFFF"
    android:strokeWidth="1.6"
    android:pathData="M0,26H108M0,84H108M24,0V108M86,0V108M58,0V20M58,88V108M0,56H18M90,56H108" />
